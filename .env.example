# ==============================================================================
# Private Chat App - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR ACTUAL SUPABASE AND DEPLOYMENT VALUES
# NEVER COMMIT REAL SECRETS OR .env FILES TO SOURCE CONTROL!
# ==============================================================================

# Backend Environment & Network Binding
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# Supabase Credentials & Endpoints
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://nkmhgzbgdztedrtdwszb.supabase.co
# Supabase Anon Key (Safe for client apps)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5rbWhnemJnZHp0ZWRydGR3c3piIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTIxNTc3MjMsImV4cCI6MjEwNzczMzcyM30.ocKyDwtF9A8NFjPL97WsIUmLM9bxvEdkLUHUpE0jFQk
# Supabase Service Role Key (STRICTLY SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5rbWhnemJnZHp0ZWRydGR3c3piIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MjE1NzcyMywiZXhwIjoyMTA3NzMzNzIzfQ.0MPx6UTZZezdPXLX5m8krk0vXJlISpiKostVcUq_RAU

# Supabase JWT / Auth verification
# By default, FastAPI validates tokens against {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# You can also set a JWT secret if your Supabase project uses HMAC secret verification.
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1

# Security & CORS
# Comma-separated or JSON list of permitted origins (e.g., Vercel frontend, local dev)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,https://your-chat-app.vercel.app

# Admin Management
# Email of the designated administrator authorized to invite or manage accounts
ADMIN_EMAIL=admin@example.com

# Flutter Web Client Config (Compiled into Flutter Web / Android at build time via --dart-define)
# API_BASE_URL=https://your-backend.onrender.com
# WS_BASE_URL=wss://your-backend.onrender.com/ws
